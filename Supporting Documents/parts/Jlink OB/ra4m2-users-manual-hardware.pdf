<x:xmpmeta xmlns:x="adobe:ns:meta/">
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
<rdf:Description rdf:about="" xmlns:xmp="http://ns.adobe.com/xap/1.0/" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
<xmp:CreateDate>2026-07-28T16:55:26+09:00</xmp:CreateDate>
<xmp:ModifyDate>2026-07-28T16:55:26+09:00</xmp:ModifyDate>
<dc:format>application/pdf</dc:format>
<pdf:Producer>Antenna House PDF Output Library 7.2.1831</pdf:Producer>
<pdf:Keywords>Leading-performance 100 MHz Arm Cortex-M33 core, up to 512 KB code flash memory with background operation, 8 KB Data flash memory, and 128 KB SRAM with Parity/ECC. High-integration with USB 2.0 Full-Speed, SDHI, Quad SPI, and advanced analog. Integrated Secure Crypto Engine with cryptography accelerators, key management support, tamper detection and power analysis resistance in concert with Arm TrustZone for integrated secure element functionality.</pdf:Keywords>
<xmp:CreatorTool>AH XSL Formatter V7.2 MR9 for Windows (x64) : 7.2.10.58935 (2022-11-24T10:59+09)</xmp:CreatorTool>
<xmp:MetadataDate>2026-07-28T16:55:26+09:00</xmp:MetadataDate>
<dc:title><rdf:Alt><rdf:li xml:lang="x-default">RA4M2 Group Userâ€™s Manual: Hardware</rdf:li></rdf:Alt></dc:title>
<dc:description><rdf:Alt><rdf:li xml:lang="x-default">Userâ€™s Manual: Hardware</rdf:li></rdf:Alt></dc:description>
<dc:creator><rdf:Seq><rdf:li>Renesas Electronics Corporation</rdf:li></rdf:Seq></dc:creator>
<dc:subject><rdf:Bag><rdf:li>Leading-performance 100 MHz Arm Cortex-M33 core</rdf:li><rdf:li>up to 512 KB code flash memory with background operation</rdf:li><rdf:li>8 KB Data flash memory</rdf:li><rdf:li>and 128 KB SRAM with Parity/ECC. High-integration with USB 2.0 Full-Speed</rdf:li><rdf:li>SDHI</rdf:li><rdf:li>Quad SPI</rdf:li><rdf:li>and advanced analog. Integrated Secure Crypto Engine with cryptography accelerators</rdf:li><rdf:li>key management support</rdf:li><rdf:li>tamper detection and power analysis resistance in concert with Arm TrustZone for integrated secure element functionality.</rdf:li></rdf:Bag></dc:subject>
</rdf:Description></rdf:RDF></x:xmpmeta>
                                                                                                   
                                                                                                   
                                                                                                   
                                                                                                   
                                                                                                   
                                                                                                   
                                                                                                   
                                                                                                   
                                                                                                   
                                                                                                   
                                                                                                   
                                                                                                   
                                                                                                   
                                                                                                   
                                                                                                   
                                                                                                   
                                                                                                   
                                                                                                   
                                                                                                   
                                                                                                   
